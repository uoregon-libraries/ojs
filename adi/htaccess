# OJS .htaccess file
# This file is used to configure URL rewriting for OJS

# Enable URL rewriting
RewriteEngine On

# Set the base directory
RewriteBase /

# Prevent redirect loops
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} !^/index\.php/install
RewriteCond %{REQUEST_URI} !^/index/install
RewriteCond %{DOCUMENT_ROOT}/config.inc.php !-f
RewriteRule ^(.*)$ /index.php/install [R=302,L]

# Handle requests for the installation page
RewriteRule ^index\.php/install$ index.php?page=install [QSA,L]
RewriteRule ^index/install$ index.php?page=install [QSA,L]

# Standard OJS URL rewriting
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?$1 [QSA,L] 